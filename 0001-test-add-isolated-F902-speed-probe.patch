diff --git a/lib/tacho-rhmi.js b/lib/tacho-rhmi.js
index 254b5fd..0ed2908 100644
--- a/lib/tacho-rhmi.js
+++ b/lib/tacho-rhmi.js
@@ -66,6 +66,25 @@ export function parseDriverWorkingState(responseBytes = []) {
   return Object.freeze({ valid: true, activity, activityCode: stateCode });
 }
 
+export function inspectVehicleSpeedDid(responseBytes = []) {
+  const bytes = Array.from(responseBytes, (value) => Number(value) & 0xff);
+  if (
+    bytes.length < 6
+    || bytes[0] !== 1
+    || bytes[1] !== 1
+    || bytes[2] !== 0x62
+    || bytes[3] !== 0xf9
+    || bytes[4] !== 0x02
+  ) {
+    return Object.freeze({ valid: false, payload: Object.freeze([]) });
+  }
+
+  return Object.freeze({
+    valid: true,
+    payload: Object.freeze(bytes.slice(5)),
+  });
+}
+
 export function parseDriverMinutesDid(responseBytes = [], expectedDid) {
   const bytes = Array.from(responseBytes, (value) => Number(value) & 0xff);
   const didHigh = (expectedDid >> 8) & 0xff;
